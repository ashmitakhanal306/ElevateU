# ElevateU Client Environment Configuration Template
# Duplicate this file to .env in the root directory and replace placeholder values with your real configuration.

# Base API endpoint for backend services
VITE_API_URL=https://api.elevateu.in/v1

# Supabase Credentials (Required for auth & database)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Client ID for Google Single Sign-On (OAuth 2.0)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id-here

# Gemini API Key for AI Features (Agentic Career Assistant & Chatbot)
VITE_GEMINI_API_KEY=your-gemini-api-key-here
